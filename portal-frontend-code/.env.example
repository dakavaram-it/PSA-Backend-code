# Copy to .env in the project root and fill in. Read by Backend/main.py.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Cadre performance scores (S17), on the ratings pipeline's own server. Optional:
# leave HOST/USER/PASSWORD blank and S17 answers {"configured": false}, so the wizard
# renders without scores instead of erroring. All three are needed to switch it on.
REPORT_RATINGS_DB_HOST=
REPORT_RATINGS_DB_PORT=3306
REPORT_RATINGS_DB_USER=
REPORT_RATINGS_DB_PASSWORD=
REPORT_RATINGS_DB_NAME=report_ratings
# Set to true wherever the app is served over HTTPS, so the session cookie is
# TLS-only. Left false for local dev and the plain-HTTP PM2 deployment.
COOKIE_SECURE=false
# Nomination PDF uploads (S24), written to leader-reports/election_nominations/DDMMYY/<uuid>.pdf.
# Optional: with ACCESS_KEY/SECRET_KEY unset, S24 answers 503 instead of failing, so the
# Dashboard still renders with the upload button disabled-by-server rather than crashing.
S3_BUCKET=leader-reports
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=