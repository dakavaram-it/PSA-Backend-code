# Copy to .env in the project root and fill in. Read by Backend/main.py.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Session JWTs. Required: login signs the login token with these and every other endpoint
# verifies it, so changing the secret invalidates every token already issued. Use a long
# random string, and the same pair as any other PSA service that has to read the token.
JWT_SECRET=
ALGORITHM=HS512
# Cadre performance scores (getCadreScores), on the ratings pipeline's own server. Optional:
# leave HOST/USER/PASSWORD blank and getCadreScores answers {"configured": false}, so the wizard
# renders without scores instead of erroring. All three are needed to switch it on.
REPORT_RATINGS_DB_HOST=
REPORT_RATINGS_DB_PORT=3306
REPORT_RATINGS_DB_USER=
REPORT_RATINGS_DB_PASSWORD=
REPORT_RATINGS_DB_NAME=report_ratings
# Nomination PDF uploads (uploadNominationFile), written to leader-reports/election_nominations/DDMMYY/<uuid>.pdf.
# Optional: with ACCESS_KEY/SECRET_KEY unset, uploadNominationFile answers 503 instead of failing, so the
# Dashboard still renders with the upload button disabled-by-server rather than crashing.
S3_BUCKET=leader-reports
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=