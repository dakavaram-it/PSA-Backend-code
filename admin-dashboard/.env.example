# Copy to `.env` and fill in. The real .env is git-ignored (holds live credentials).
# Use a least-privilege READ-ONLY user in production (GRANT SELECT only), not root.
DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=ua_dashboard_ro
DB_PASSWORD=changeme
DB_NAME=dakavara_pa

# Admin console login — the ONLY credentials that can sign in. Both are
# required; the app refuses to start without them. Checked server-side
# (Backend/routers/auth.py), never shipped to the browser.
LOGIN_USERNAME=admin
LOGIN_PASSWORD=changeme
