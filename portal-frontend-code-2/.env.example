# Database configuration — same live dakavara_pa cluster the other projects read.
# Dashboard 2 is read-only, so no JWT, no S3, no cookie settings live here.
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=dakavara_pa

# Connection pool size (see Backend/config.py)
DB_POOL_SIZE=8
