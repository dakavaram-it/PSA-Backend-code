# Database configuration — same live dakavara_pa cluster the other projects read.
# Dashboard 2 is read-only, so no JWT, no S3, no cookie settings live here.
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=dakavara_pa

# The portal's session token. Dashboard 2 issues no tokens of its own — it VERIFIES the
# one ../portal-frontend-code's /login handed the browser, so there is one login, one
# session and one credential store for the whole portal. These two values must match
# that project's .env exactly or every write here answers 401.
JWT_SECRET="your-jwt-secret"
ALGORITHM="HS512"

# Connection pool size (see Backend/config.py)
DB_POOL_SIZE=8
