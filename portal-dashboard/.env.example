# Copy to `.env` and fill in. The real .env is git-ignored (holds live credentials).
#
# Same dakavara_pa database as ../admin-dashboard, but a DIFFERENT set of tables
# (`user`, `team_type`, `entitlement`, `group_entitlement`, `user_groups`), and
# this backend writes to them — see Backend/routers/users.py and
# Backend/routers/entitlements.py — so a SELECT-only grant is not enough here.
#
# Each project keeps its own .env because gateway.py loads them one at a time
# with override=True: every backend reads DB_HOST/DB_USER at import time, so
# whichever file was loaded last would otherwise win for all of them.
DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=ua_portal
DB_PASSWORD=changeme
DB_NAME=dakavara_pa

# Max concurrent connections per pool (the read and write pools are separate, so
# this is the cap for each). Optional — Backend/config.py defaults to 8.
#DB_POOL_SIZE=8

# No LOGIN_USERNAME/LOGIN_PASSWORD here on purpose: this backend has no auth
# router. The console's one operator login is checked by ../admin-dashboard's
# POST /api/login, and the frontend gates both nav items behind that one screen.
