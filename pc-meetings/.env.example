# Copy to `.env` and fill in. The real .env is git-ignored (holds live credentials).
# Use a least-privilege user in production: SELECT everywhere, plus INSERT/UPDATE on
# `mytdp.feedback_comment` and `mytdp.meeting_remark` (the only two tables written).
DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=meetings_rw
DB_PASSWORD=changeme
# Committee meetings live in `mytdp`. Spell it out: gateway.py loads every project's
# .env into one process, so another project's DB_NAME is already in os.environ and
# would win config.py's getenv fallback.
DB_NAME=mytdp
# Programmes' roster tables (role, program, leader, ...) — a sibling schema on the
# same host, read cross-schema by the same user.
PARTY_TRACK_DB=party_track

# The portal (portal-frontend-code/Backend) mints the session token; this
# service only verifies it, so both sides must carry the same secret and
# algorithm — copy them from portal-frontend-code/.env.
JWT_SECRET=
ALGORITHM="HS512"
# Where a user's assembly grants live (user_state_access_info /
# user_constituency_access_info) — the portal's own schema, read cross-schema.
PORTAL_DB_NAME=dakavara_pa
