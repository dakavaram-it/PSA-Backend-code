DB_HOST=db-projectk-prod.cluster-cxksnp5k9yp8.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=psa_user
DB_PASSWORD="hf9otAgC#hf946!k9"
# Spelt out rather than left to config.py's default: gateway.py loads every
# project's .env into one process, so an earlier project's DB_NAME
# (dakavara_pa) is already in os.environ and would win the getenv fallback.
DB_NAME=mytdp
# Programmes' roster tables (role, program, leader, ...) — a sibling schema on
# the same host, read cross-schema by the same user.
PARTY_TRACK_DB=party_track

# The portal (portal-frontend-code/Backend) mints the session token; this
# service only verifies it, so both sides must carry the same secret and
# algorithm. Spelt out here rather than left to the portal's .env: gateway.py
# loads every project's into one process and dotenv does not override what is
# already set, so which one wins depends on mount order.
JWT_SECRET="K#4j89!Yxr$1O1L"
ALGORITHM="HS512"
# Where a user's assembly grants live (user_state_access_info /
# user_constituency_access_info) — the portal's own schema, read cross-schema.
PORTAL_DB_NAME=dakavara_pa
