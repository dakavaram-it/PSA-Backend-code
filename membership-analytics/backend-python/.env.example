APP_NAME=pa-track-workflow-api
APP_ENV=local
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Existing DB with master data
DAKAVARA_DB_HOST=
DAKAVARA_DB_PORT=3306
DAKAVARA_DB_USER=
DAKAVARA_DB_PASSWORD=
DAKAVARA_DB_NAME=dakavara_pa

# New tracking DB
PA_TRACK_DB_HOST=
PA_TRACK_DB_PORT=3306
PA_TRACK_DB_USER=
PA_TRACK_DB_PASSWORD=
PA_TRACK_DB_NAME=pa_track

# SIR (Special Intensive Revision) form-count DB — separate RDS instance (mytdp).
# Read-only creds are enough for the analytics; data entry (submit/edit) needs a
# writable SIR_DB_USER / SIR_DB_PASSWORD.
SIR_DB_HOST=
SIR_DB_PORT=3306
SIR_DB_USER=
SIR_DB_PASSWORD=
SIR_DB_NAME=mytdp

CACHE_TTL_SECONDS=3600
CACHE_DIR=cache
DEFAULT_ENROLLMENT_ID=2
