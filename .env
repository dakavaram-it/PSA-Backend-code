# Set to true to enable legacy sync, false to disable it. During testing time would like to keep it 
# false to avoid any potential issues with the legacy sync process. Once we are confident that the new 
# sync process is working correctly, we can enable the legacy sync process if needed.to ensure the 
# legacy sync process 
ENABLE_LEGACY_SYNC=false
ENABLE_COMMITTEE_LEGACY_SYNC=false

# KSS gate for adding committee candidates.
#   true  -> check KSS membership before adding a committee candidate (existing flow)
#   false -> skip the KSS check; any cadre can be added
ENABLE_COMMITTEE_KSS_CHECK=false